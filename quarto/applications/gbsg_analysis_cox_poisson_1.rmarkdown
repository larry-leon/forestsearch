```


## Poisson Cross-Validation

### Out-of-Bag (N-Fold) Cross-Validation

```{r pois-oob-cv}
#| eval: true

t0 <- proc.time()

fs_pois_OOB <- forestsearch_Kfold(
  fs.est = fs_pois,
  details = FALSE,
  Kfolds = round(nrow(df.analysis) / 100, 0),
  parallel_args = list(
    plan = "multisession",
    workers = n_cores,
    show_message = TRUE
  )
)

plan("sequential")
timings$pois_oob <- (proc.time() - t0)["elapsed"]

cv_pois_out <- forestsearch_KfoldOut(
  res = fs_pois_OOB,
  details = FALSE,
  outall = TRUE
)

pois_cv_tables <- cv_summary_tables(cv_pois_out)
pois_cv_tables$combined_table
pois_cv_tables$metrics_table
```


