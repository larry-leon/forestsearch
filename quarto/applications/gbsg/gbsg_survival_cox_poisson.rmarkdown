# Part II: Poisson Rate Model Analysis {#sec-poisson}

## Rationale

The Poisson regression model with an offset for person-time provides an
alternative to the Cox PH model for estimating treatment effects on the
event rate scale (incidence rate ratio, IRR). Under an exponential
survival assumption, the Poisson IRR is approximately equal to the Cox HR.

This section applies ForestSearch with `outcome_type = "count"` and
`effect_measure = "IRR"` to the GBSG data, treating each patient's
binary event indicator (`status`) as a count (0 or 1) and
`log(time_months)` as the offset. This is the standard piecewise
exponential model approximation with a single interval per patient.

Comparing the Poisson and Cox analyses serves two purposes:

1. **Validation**: If both models identify the same subgroup with similar
   effect sizes, this strengthens confidence in the findings.
2. **GLM pipeline verification**: Demonstrates that the ForestSearch GLM
   extension produces coherent results on real clinical trial data.


## ITT Poisson Model

```{r pois-itt}
# Verify the Poisson approximation at the ITT level
cox_itt <- coxph(
  Surv(time_months, status) ~ hormon,
  data = df.analysis
)
pois_itt <- glm(
  status ~ hormon,
  family = poisson(),
  offset = log(pmax(time_months, 1e-6)),
  data = df.analysis
)

cat("ITT Cox  HR:      ", sprintf("%.4f", exp(coef(cox_itt))), "\n")
cat("ITT Poisson IRR:  ", sprintf("%.4f", exp(coef(pois_itt)[["hormon"]])), "\n")
cat("Absolute diff:    ",
    sprintf("%.4f", abs(exp(coef(cox_itt)) - exp(coef(pois_itt)[["hormon"]]))),
    "\n")
```


## Running ForestSearch (Poisson)

The Poisson analysis uses `outcome_type = "count"` with `effect_measure = "IRR"`
and `offset.name = "time_months"`. Screening and consistency thresholds are
set identically to the Cox analysis so that any differences in results
reflect the model, not tuning.

```{r forestsearch-poisson}
#| fig-width: 10
#| fig-height: 7

t0 <- proc.time()

# All forestsearch() parameters shown with their default values.
# This call exercises the GLM (Poisson rate) pipeline: outcome_type = "count",
# effect_measure = "IRR", and offset.name = "time_months".
# event.name is not needed for count outcomes; forestsearch() creates an
# internal placeholder when the event column is absent.
fs_pois <- forestsearch(
  df.analysis                = df.analysis,                  # required

  # ─── Variable names ─────────────────────────────────────────────────────
  outcome.name               = pois_outcome.name,            # default "tte"
  event.name                 = "event",                      # default "event"; placeholder used for count
  treat.name                 = pois_treat.name,              # default "treat"
  id.name                    = id.name,                      # default "id"
  potentialOutcome.name      = NULL,                         # default NULL
  flag_harm.name             = NULL,                         # default NULL
  confounders.name           = confounders.name,             # default NULL

  # ─── Parallel processing ────────────────────────────────────────────────
  parallel_args              = list(plan = "multisession",
                                    workers = n_cores,
                                    show_message = TRUE),    # default plan="multisession"

  # ─── Prediction / RCT flag ──────────────────────────────────────────────
  df.predict                 = NULL,                         # default NULL
  df.test                    = NULL,                         # default NULL
  is.RCT                     = TRUE,                         # default TRUE
  seedit                     = 8316951,                      # default 8316951
  est.scale                  = "hr",                         # default "hr"

  # ─── Factor selection: LASSO + GRF ──────────────────────────────────────
  use_lasso                  = TRUE,                         # default TRUE
  use_grf                    = TRUE,                         # default TRUE
  grf_res                    = NULL,                         # default NULL
  grf_cuts                   = NULL,                         # default NULL
  max_n_confounders          = 1000,                         # default 1000
  grf_depth                  = 2,                            # default 2
  dmin.grf                   = 0.0,                          # default 0.0
  frac.tau                   = 0.8,                          # default 0.8
  return_selected_cuts_only  = TRUE,                         # default TRUE
  vi.grf.min                 = grf_vi_min,                   # default -0.2
  tune_grf                   = grf_tune,                     # default FALSE

  # ─── Cuts / discretization ──────────────────────────────────────────────
  conf_force                 = NULL,                         # default NULL
  defaultcut_names           = NULL,                         # default NULL
  cut_type                   = "default",                    # default "default"
  exclude_cuts               = NULL,                         # default NULL
  replace_med_grf            = FALSE,                        # default FALSE
  cont.cutoff                = 4,                            # default 4
  conf.cont_medians          = NULL,                         # default NULL
  conf.cont_medians_force    = NULL,                         # default NULL
  conf.cont_jcuts            = NULL,                         # default NULL

  # ─── Subgroup constraints ───────────────────────────────────────────────
  n.min                      = fs_n.min,                     # default 60
  d0.min                     = fs_d0.min,                    # default 10; reinterpreted for binary
  d1.min                     = fs_d1.min,                    # default 10
  maxk                       = fs_maxk,                      # default 2
  max_subgroups_search       = fs_max_subgroups_search,      # default 10
  max.minutes                = 3,                            # default 3

  # ─── Thresholds ─────────────────────────────────────────────────────────
  effect.threshold           = NULL,                         # default NULL
  consistency.threshold      = NULL,                         # default NULL
  hr.threshold               = fs_hr.threshold,              # default 1.25; ratio scale (IRR)
  hr.consistency             = fs_hr.consistency,            # default 1.0

  # ─── Selection (sg_focus / Pareto neighborhood) ─────────────────────────
  sg_focus                   = "maxSG",                      # default "hr"
  selection_rule             = "neighborhood",               # default "neighborhood"
  effect_neighborhood        = 0.10,                         # default 0.10

  # ─── Consistency evaluation ─────────────────────────────────────────────
  fs.splits                  = fs_splits,                    # default 1000
  m1.threshold               = Inf,                          # default Inf
  pconsistency.threshold     = fs_pconsistency.threshold,    # default 0.90
  stop_threshold             = fs_stop_threshold,            # default 0.95

  # ─── Two-stage consistency ──────────────────────────────────────────────
  use_twostage               = TRUE,                         # default TRUE
  twostage_args              = list(),                       # default list()

  # ─── GLM outcome support (count / Poisson) ──────────────────────────────
  outcome_type               = "count",                      # default "survival"
  effect_measure             = pois_effect_measure,          # default NULL -> "IRR" for count
  offset.name                = pois_offset.name,             # default NULL; required for count
  adverse_outcome            = NULL,                         # default NULL -> TRUE for binary/count
  overdispersion             = "none",                       # default "none"; or "quasi", "negbin"
  grf_count_transform        = "log",                        # default "log"; or "identity"

  # ─── Propensity-score adjustment ────────────────────────────────────────
  ps_method                  = NULL,                         # default NULL
  ps_adjust_method           = "none",                       # default "none"
  ps_hat                     = NULL,                         # default NULL

  # ─── Output / diagnostics ───────────────────────────────────────────────
  show_candidate_summary     = TRUE,                         # default FALSE
  minp                       = 0.025,                        # default 0.025
  details                    = TRUE,                         # default FALSE
  quiet                      = FALSE,                        # default FALSE
  by.risk                    = 12,                           # default 12
  plot.sg                    = FALSE,                        # default FALSE; KM not applicable -> use plot_sg_glm_outcomes()
  plot.grf                   = FALSE                         # default FALSE
)

plan("sequential")
timings$pois_fs <- (proc.time() - t0)["elapsed"]

cat("\nForestSearch (Poisson) completed in",
    round(timings$pois_fs, 1), "seconds\n")
```


