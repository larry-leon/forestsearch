  subtitle     = NULL,                                       # default NULL
  show_metrics = TRUE,                                       # default TRUE
  digits       = 3,                                          # default 3
  font_size    = 12,                                         # default 12
  use_gt       = TRUE                                        # default TRUE
)
pois_cv_tables$combined_table
pois_cv_tables$metrics_table
```


