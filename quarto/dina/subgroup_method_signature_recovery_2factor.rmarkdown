                 false_discovery_rate = "false-discovery rate") |>
  gt::tab_source_note(gt::md(
    "*Under no heterogeneity any discovered subgroup is a false positive. The
     larger two-factor hypothesis space (`maxk = 2` / `max_depth = 2`) can raise
     the false-discovery rate relative to the single-factor study; the harm
     thresholds remain the guard.*")) |>
  gt::tab_options(table.font.size = 12)
```

