---
title: "ACTG175 Binary Harm Search: Simulation Study"
format: html
---

```{r setup}
#| code-fold: true
#| code-summary: "Setup and parameters (click to expand)"

library(forestsearch)
library(speff2trial)
library(data.table)
library(gt)
library(ggplot2)
library(doFuture)
library(foreach)

set.seed(8316951L)

# -- Simulation control --------------------------------------------------------
nsims_alt   <- 20L
nsims_null  <- 20L
n_workers   <- 4L
sim_n       <- 1000L

# -- FS parameters -------------------------------------------------------------
c1 <- 1.25           # hr.threshold (OR scale)
c2 <- 1.0            # hr.consistency
fs_pconsistency    <- 0.80
fs_splits          <- 500L
fs_n_min           <- 60L
fs_d0_min          <- 10L
fs_d1_min          <- 10L
fs_maxk            <- 2L
fs_vi_grf_min      <- -0.2
fs_dmin_grf        <- 0
fs_seedit          <- 8316951L
fs_cont_cutoff     <- 4L
fs_sg_focus        <- "minSG"
fs_cut_type        <- "default"
fs_use_lasso       <- FALSE
fs_use_grf         <- TRUE
fs_is_rct          <- TRUE

# -- GRF standalone parameters ------------------------------------------------
grf_dmin           <- 0.1
grf_maxdepth       <- 2L
grf_sg_criterion   <- "mDiff"

# -- Reporting -----------------------------------------------------------------
sg_notation        <- "harm"

# -- Calibration ---------------------------------------------------------------
cal_target_or      <- 2.0

# -- Diagnostic capture --------------------------------------------------------
diag_keep          <- c("fs_full", "candidate_table")
diag_keep_first_n  <- 5L

# -- Plot thresholds -----------------------------------------------------------
sgdist_min_pct_alt  <- 10
sgdist_min_pct_null <- 5
sgdist_top_k        <- 10L
ordist_ylim         <- c(0, 6)
```

# Data Preparation {#sec-data}

```{r data-prep}
#| code-fold: true
#| code-summary: "ACTG175 data prep (click to expand)"

# ACTG175: arm 1 = ZDV+ddI (experimental), arm 3 = ddI (control)
actg_df <- subset(speff2trial::ACTG175, arms %in% c(1L, 3L))
actg_df$id <- seq_len(nrow(actg_df))

# Treatment: ZDV+ddI = 1, ddI = 0 (NO switching)
actg_df$treat <- ifelse(actg_df$arms == 1L, 1L, 0L)

# Binary outcome: adverse (failure to improve)
actg_df$y_binary <- as.integer(actg_df$cd420 <= actg_df$cd40)
actg_df <- actg_df[!is.na(actg_df$cd420), ]

# -- DGM factor variables -----------------------------------------------------
# z1, z2: TRUE subgroup Q = {cd40 > 421 & wtkg > 82.3}
# (from observed-data FS result — see companion analysis document)
actg_df$z1  <- as.factor(ifelse(actg_df$cd40 > 421, 1L, 0L))
actg_df$z2  <- as.factor(ifelse(actg_df$wtkg > 82.3, 1L, 0L))

# z7-z12: truly binary indicators (no continuous counterpart)
actg_df$z7  <- as.factor(actg_df$hemo)
actg_df$z8  <- as.factor(actg_df$homo)
actg_df$z9  <- as.factor(actg_df$drugs)
actg_df$z10 <- as.factor(actg_df$race)
actg_df$z11 <- as.factor(actg_df$gender)
actg_df$z12 <- as.factor(actg_df$symptom)

actg_df$flag_harm_ref <- as.integer(actg_df$z1 == 1 & actg_df$z2 == 1)

# -- Analysis covariates (what the analyst sees) -------------------------------
cont_vars <- c("age", "preanti", "wtkg", "karnof", "cd40", "cd80")
bin_vars  <- c("hemo", "homo", "drugs", "race", "gender", "symptom")
for (v in bin_vars) actg_df[[v]] <- as.factor(actg_df[[v]])
confounders <- c(cont_vars, bin_vars)

# -- DGM variable sets ---------------------------------------------------------
dgm_factor_vars   <- c("z1", "z2", paste0("z", 7:12))
dgm_cont_vars     <- cont_vars
dgm_subgroup_vars <- c("z1", "z2")
dgm_subgroup_cuts <- list(z1 = 1L, z2 = 1L)

# -- Summary -------------------------------------------------------------------
Q_n   <- sum(actg_df$flag_harm_ref)
Q_N   <- nrow(actg_df)
Q_pct <- 100 * Q_n / Q_N

cat(sprintf("N = %d, Q prevalence = %d / %d (%.1f%%)\n", Q_N, Q_n, Q_N, Q_pct))
cat(sprintf("Adverse rate: overall=%.1f%%, ZDV+ddI=%.1f%%, ddI=%.1f%%\n",
    100 * mean(actg_df$y_binary),
    100 * mean(actg_df$y_binary[actg_df$treat == 1]),
    100 * mean(actg_df$y_binary[actg_df$treat == 0])))
```

# DGM Calibration {#sec-calibration}

Target: OR(Q) = `r cal_target_or` on the adverse scale.  The DGM
includes factor variables (for subgroup definition) and raw continuous
covariates (for a richer prognostic baseline), consistent with the
survival `generate_aft_dgm_flex()` design.

```{r calibrate}
dgm_calibrated <- calibrate_glm_interaction(
  data            = actg_df,
  factor_vars     = dgm_factor_vars,
  continuous_vars = dgm_cont_vars,
  outcome_var     = "y_binary",
  treatment_var   = "treat",
  target_effect   = cal_target_or,
  outcome_type    = "binary",
  effect_measure  = "OR",
  subgroup_vars   = dgm_subgroup_vars,
  subgroup_cuts   = dgm_subgroup_cuts,
  k_inter_range   = c(0, 3),
  grid_step       = 0.05,
  n_super         = 5000L,
  seed            = 8316951L,
  verbose         = TRUE
)

cat(sprintf("\n  OR(Q):   %.3f (target: %.1f)\n",
    dgm_calibrated$hazard_ratios$harm_subgroup, cal_target_or))
cat(sprintf("  OR(Qc):  %.3f\n", dgm_calibrated$hazard_ratios$no_harm_subgroup))
cat(sprintf("  OR(ITT): %.3f\n", dgm_calibrated$hazard_ratios$overall))
```

```{r null-dgm}
dgm_null <- generate_glm_dgm(
  data            = actg_df,
  factor_vars     = dgm_factor_vars,
  continuous_vars = dgm_cont_vars,
  outcome_var     = "y_binary",
  treatment_var   = "treat",
  outcome_type    = "binary",
  subgroup_vars   = dgm_subgroup_vars,
  subgroup_cuts   = dgm_subgroup_cuts,
  model           = "null",
  n_super         = 5000L,
  seed            = 8316951L,
  verbose         = TRUE
)
```

# Single Trial Sanity Check {#sec-single-trial}

```{r single-trial}
#| code-fold: true
#| code-summary: "Single simulated trial + FS analysis (click to expand)"

df_sim <- simulate_from_glm_dgm(dgm_calibrated, n = sim_n, seed = 42)
fit_Q  <- glm(y_sim ~ treat_sim,
              data = df_sim[df_sim$flag_harm == 1, ], family = binomial)
cat(sprintf("Single trial: N=%d, |Q|=%d, empirical OR(Q)=%.2f (target %.1f)\n",
    nrow(df_sim), sum(df_sim$flag_harm), exp(coef(fit_Q)["treat_sim"]),
    cal_target_or))

fs_single <- forestsearch(
  df.analysis = df_sim, confounders.name = confounders,
  outcome.name = "y_sim", event.name = "y_sim",
  treat.name = "treat_sim", id.name = "id",
  outcome_type = "binary", effect_measure = "OR",
  seedit = fs_seedit, n.min = fs_n_min, d0.min = fs_d0_min,
  d1.min = fs_d1_min, hr.threshold = c1, hr.consistency = c2,
  pconsistency.threshold = fs_pconsistency, fs.splits = fs_splits,
  maxk = fs_maxk, sg_focus = fs_sg_focus, use_lasso = fs_use_lasso,
  use_grf = fs_use_grf, is.RCT = fs_is_rct, vi.grf.min = fs_vi_grf_min,
  dmin.grf = fs_dmin_grf, cont.cutoff = fs_cont_cutoff,
  details = TRUE, quiet = FALSE,
  parallel_args = list(plan = "sequential", workers = 1,
                        show_message = FALSE)
)

fs_single_tabs <- sg_tables(fs_single, ndecimals = 3)
fs_single_tabs$sg10_out
fs_single_tabs$tab_estimates
```

# Full Simulation Study {#sec-sims}

## Parameter Lists

```{r sim-params}
#| code-fold: true
#| code-summary: "FS / GRF parameter lists (click to expand)"

plan(multisession, workers = n_workers)
cat("Using", n_workers, "parallel workers\n")

fs_params <- list(
  outcome.name           = "y_sim",
  event.name             = "y_sim",
  treat.name             = "treat_sim",
  id.name                = "id",
  outcome_type           = "binary",
  effect_measure         = "OR",
  use_lasso              = fs_use_lasso,
  use_grf                = fs_use_grf,
  use_twostage           = TRUE,
  cont.cutoff            = fs_cont_cutoff,
  cut_type               = fs_cut_type,
  hr.threshold           = c1,
  hr.consistency         = c2,
  pconsistency.threshold = fs_pconsistency,
  sg_focus               = fs_sg_focus,
  fs.splits              = fs_splits,
  n.min                  = fs_n_min,
  d0.min                 = fs_d0_min,
  d1.min                 = fs_d1_min,
  maxk                   = fs_maxk,
  vi.grf.min             = fs_vi_grf_min,
  dmin.grf               = fs_dmin_grf,
  seedit                 = fs_seedit,
  parallel_args          = list(plan = "sequential", workers = 1,
                                show_message = FALSE)
)

grf_params <- list(
  dmin.grf     = grf_dmin,
  maxdepth     = grf_maxdepth,
  sg.criterion = grf_sg_criterion
)
```

## H1 Simulations (Calibrated HTE)

```{r run-alt}
#| code-fold: true
#| code-summary: "H1 simulation loop (click to expand)"
#| output: false

cat("Running", nsims_alt, "simulations under H1...\n")
t0 <- proc.time()[3]

results_alt_raw <- foreach(
  sim = seq_len(nsims_alt),
  .errorhandling = "pass",
  .options.future = list(
    packages = c("forestsearch", "survival", "data.table", "future"),
    seed = TRUE
  )
) %dofuture% {
  future::plan("sequential")
  run_simulation_analysis(
    sim_id           = sim,
    dgm              = dgm_calibrated,
    n_sample         = sim_n,
    confounders_base = confounders,
    run_fs           = TRUE,
    run_fs_grf       = FALSE,
    run_grf          = TRUE,
    fs_params        = fs_params,
    grf_params       = grf_params,
    keep             = diag_keep,
    keep_first_n     = diag_keep_first_n,
    verbose          = FALSE
  )
}

t_alt <- proc.time()[3] - t0
results_alt <- collect_results(results_alt_raw, "H1 alt",
                               keep_diagnostics = diag_keep_first_n > 0L)
n_failed_alt <- attr(results_alt, "n_failed")

cat(sprintf("Completed in %.1f min (%d rows, %d failed)\n",
    t_alt / 60, nrow(results_alt), n_failed_alt))
```

## H0 Simulations (Null — Homogeneous Effect)

```{r run-null}
#| code-fold: true
#| code-summary: "H0 simulation loop (click to expand)"
#| output: false

cat("Running", nsims_null, "simulations under H0...\n")
t0 <- proc.time()[3]

results_null_raw <- foreach(
  sim = seq_len(nsims_null),
  .errorhandling = "pass",
  .options.future = list(
    packages = c("forestsearch", "survival", "data.table", "future"),
    seed = TRUE
  )
) %dofuture% {
  future::plan("sequential")
  run_simulation_analysis(
    sim_id           = sim,
    dgm              = dgm_null,
    n_sample         = sim_n,
    confounders_base = confounders,
    run_fs           = TRUE,
    run_fs_grf       = FALSE,
    run_grf          = TRUE,
    fs_params        = fs_params,
    grf_params       = grf_params,
    verbose          = FALSE
  )
}

t_null <- proc.time()[3] - t0
results_null <- collect_results(results_null_raw, "H0 null")
n_failed_null <- attr(results_null, "n_failed")

cat(sprintf("Completed in %.1f min (%d rows, %d failed)\n",
    t_null / 60, nrow(results_null), n_failed_null))
```

# Operating Characteristics {#sec-oc}

## H1: Detection + Classification

```{r oc-alt}
format_oc_results(
  results_alt,
  metrics   = c("detection", "classification", "subgroup_size"),
  digits    = 2,
  digits_hr = 2,
  title     = "ACTG175 Binary: Harm Subgroup Identification",
  subtitle  = sprintf(
    "n = %d, %d sims, OR(Q) = %.2f, OR(Qc) = %.2f",
    sim_n, nsims_alt,
    dgm_calibrated$hazard_ratios$harm_subgroup,
    dgm_calibrated$hazard_ratios$no_harm_subgroup
  ),
  subgroup_notation = sg_notation
)
```

## H1: Estimation Tables

```{r oc-alt-estimation}
build_estimation_table(
  results         = results_alt,
  dgm             = dgm_calibrated,
  analysis_method = "FS",
  subgroup_notation = sg_notation,
  title           = "FS: Effect Estimates Under H1"
)

build_estimation_table(
  results         = results_alt,
  dgm             = dgm_calibrated,
  analysis_method = "GRF",
  subgroup_notation = sg_notation,
  title           = "GRF: Effect Estimates Under H1"
)
```

## H1: Classification Tables

```{r oc-alt-classification}
scenario_alt <- list(
  H1 = list(
    results    = results_alt,
    dgm        = dgm_calibrated,
    hypothesis = "alt",
    n_sample   = sim_n,
    label      = "ACTG175"
  )
)

build_classification_table(
  scenario_alt,
  analyses          = "FS",
  subgroup_notation = sg_notation,
  title             = "FS: Classification Under H1"
)

build_classification_table(
  scenario_alt,
  analyses          = "GRF",
  subgroup_notation = sg_notation,
  title             = "GRF: Classification Under H1"
)
```

## H1: Subgroup Distribution

```{r oc-alt-sgdist, fig.width=9, fig.height=6}
plot_sg_distribution(
  results_alt[results_alt$analysis == "FS", ],
  any_col   = "any.H",
  label_col = "sg.def",
  min_pct   = sgdist_min_pct_alt,
  top_k     = sgdist_top_k,
  title     = "FS: Identified Subgroup Distribution (H1)"
)
```

## H1: OR Distribution

```{r oc-alt-ordist, fig.width=9, fig.height=4.5}
or_Q_true <- dgm_calibrated$hazard_ratios$harm_subgroup

plot_effect_distribution(
  results           = results_alt,
  analysis_method   = "FS",
  effect_measure    = "OR",
  subgroup_notation = sg_notation,
  reference_effect  = or_Q_true,
  ylim              = ordist_ylim,
  title             = "FS: OR Estimates Across Simulations (H1)"
)
```

## H0: Type I Error

```{r oc-null}
format_oc_results(
  results_null,
  metrics   = c("detection", "classification"),
  digits    = 2,
  title     = "ACTG175 Binary: Type I Error (Null)",
  subtitle  = sprintf(
    "n = %d, %d sims, OR(ITT) = %.2f",
    sim_n, nsims_null,
    dgm_null$hazard_ratios$overall
  ),
  subgroup_notation = sg_notation
)
```

## H0: Estimation Tables

```{r oc-null-estimation}
build_estimation_table(
  results         = results_null,
  dgm             = dgm_null,
  analysis_method = "FS",
  subgroup_notation = sg_notation,
  title           = "FS: Effect Estimates Under H0"
)

build_estimation_table(
  results         = results_null,
  dgm             = dgm_null,
  analysis_method = "GRF",
  subgroup_notation = sg_notation,
  title           = "GRF: Effect Estimates Under H0"
)
```

## H0: Subgroup Distribution

```{r oc-null-sgdist, fig.width=9, fig.height=6}
plot_sg_distribution(
  results_null[results_null$analysis == "FS", ],
  any_col   = "any.H",
  label_col = "sg.def",
  min_pct   = sgdist_min_pct_null,
  top_k     = sgdist_top_k,
  title     = "FS: Identified Subgroup Distribution (H0)"
)
```

# Timing

```{r timing}
cat(sprintf("H1: %.1f min (%d sims)\n", t_alt / 60, nsims_alt))
cat(sprintf("H0: %.1f min (%d sims)\n", t_null / 60, nsims_null))
plan(sequential)
```

