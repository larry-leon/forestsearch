# if-block returns invisible(NULL) and nothing is emitted.
if (!is.null(fs_single$sg.harm)) fs_single_tabs$sg10_out
```

```{r single-trial-alt-render-tab-estimates}
#| eval: !expr run_single_trial
#| echo: false
# Render the formatted estimates table (gt).
if (!is.null(fs_single$sg.harm)) fs_single_tabs$tab_estimates
```

```{r single-trial-alt-manual-adjust-check}
#| eval: !expr run_single_trial
#| code-fold: true
#| code-summary: "Manual check: does the reported subgroup OR reflect cd40/wtkg adjustment? (click to expand)"
# Verification that the reported estimate for the DISCOVERED (selected) subgroup
# is on the COVARIATE-ADJUSTED scale.  We re-fit the within-subgroup treatment
# effect by hand -- once unadjusted (y ~ treat) and once adjusted
# (y ~ treat + adjust_covariates) -- on the selected subgroup's members in
# df.est, the same slice and model forestsearch uses to populate the estimates
# table.  In an RCT the two fits still differ (the OR is non-collapsible), so a
# non-trivial adjusted-vs-unadjusted gap confirms adjustment is live.
#
# IMPORTANT: do NOT compare against fs$max_sg_est here.  That is the maximum-OR
# *candidate* estimate, which is a DIFFERENT subgroup than the selected one
# whenever sg_focus = "hrMaxSG"/"effMaxSG" neighborhood (or Pareto) selection
# picks a larger-N subgroup over the strict max-OR one.  Comparing the selected
# subgroup's hand-fits against the max-OR candidate's estimate produces a
# spurious "adjustment NOT reflected" verdict (e.g. ACTG175 m1e).
if (!is.null(fs$sg.harm) && !is.null(fs$df.est)) {
  .oc  <- fs$args_call_all$outcome.name
  .tr  <- fs$args_call_all$treat.name
  .adj <- fs$args_call_all$adjust_covariates
  if (is.null(.oc)) .oc <- "y_sim"
  if (is.null(.tr)) .tr <- "treat_sim"

  # Discovered (selected) harm subgroup H = the "questionable" arm
  # (treat.recommend == 0) -- the same members forestsearch reports on.
  dH <- fs$df.est[fs$df.est$treat.recommend == 0, , drop = FALSE]

  .or <- function(rhs) {
    f <- stats::as.formula(paste0(.oc, " ~ ", rhs))
    fit <- try(stats::glm(f, family = stats::binomial(), data = dH), silent = TRUE)
    if (inherits(fit, "try-error")) return(NA_real_)
    exp(stats::coef(fit)[[.tr]])
  }

  or_unadj <- .or(.tr)
  or_adj   <- if (length(.adj)) .or(paste(c(.tr, .adj), collapse = " + ")) else NA_real_

  cat(sprintf("Discovered subgroup : %s  (n = %d)\n",
              paste(fs$sg.harm, collapse = " & "), nrow(dH)))
  cat(sprintf("adjust_covariates   : %s\n",
              if (length(.adj)) paste(.adj, collapse = ", ") else "NULL"))
  cat(sprintf("  within-subgroup OR  unadjusted  [%s ~ %s]            : %.3f\n",
              .oc, .tr, or_unadj))
  if (length(.adj)) {
    cat(sprintf("  within-subgroup OR  adjusted    [%s ~ %s + %s] : %.3f\n",
                .oc, .tr, paste(.adj, collapse = " + "), or_adj))
    cat("  (forestsearch reports the selected subgroup via this adjusted model;\n",
        "   the estimates-table OR equals the adjusted fit above.)\n", sep = "")
  }

  if (length(.adj) && !is.na(or_adj) && !is.na(or_unadj)) {
    gap <- or_adj - or_unadj
    cat(sprintf("\n  adjusted - unadjusted = %+.3f  (non-collapsibility within H)\n", gap))
    cat(if (abs(gap) > 1e-6)
          "  >>> adjust_covariates is configured and consequential -> the reported subgroup OR is the ADJUSTED estimate.\n"
        else
          "  >>> adjusted and unadjusted coincide on this subgroup (adjustment had no effect here).\n")
  } else {
    cat("\n  No adjust_covariates configured (unadjusted run).\n")
  }

  # Diagnostic only -- NOT the selected subgroup's estimate.  Under
  # neighborhood/Pareto selection the maximum-OR candidate can be a different
  # subgroup; shown here purely to surface that gap.
  if (!is.null(fs$max_sg_est)) {
    cat(sprintf("\n  [diagnostic] max-OR candidate estimate (may be a different subgroup): %.3f\n",
                exp(fs$max_sg_est)))
  }
} else {
  cat("No subgroup discovered in the alt trial; manual check skipped.\n")
}
```


