#| eval: !expr run_single_trial && skip_loo

cat("> **LOO skipped.** No harm subgroup was identified in the ",
    "full-analysis FS run (`fs$sg.harm` is `NULL`), so leave-one-out ",
    "cross-validation has nothing to evaluate.\n", sep = "")
```

### LOO Summary

```{r fs-loo-summary-text-null}
#| eval: !expr run_single_trial && run_loo

cat(cv_summary_text(fs_loo_result, est.scale = "hr"), "\n")
cat(sprintf("Subgroup found in %.0f%% of %d folds.\n",
            fs_loo_result$prop_SG_found, N_loo))
```

### LOO Tables

The `cv_summary_tables()` helper returns five publication-ready `gt`
tables. The first is the combined ITT + subgroup view; the next three
are component estimation tables (ITT, full-analysis subgroup, LOO
                                 subgroup) that show the underlying treatment-effect estimates with
confidence intervals.

```{r fs-loo-tables-null}
#| eval: !expr run_single_trial && run_loo

loo_out  <- forestsearch_KfoldOut(fs_loo_result, outall = TRUE,
                                  digits = 2)
loo_tabs <- cv_summary_tables(
  loo_out,
  title    = "ACTG175 Leave-One-Out CV Summary (Binary, OR)",
  subtitle = sprintf("ITT and Subgroup Estimates: Full Analysis (FA) vs LOO (N=%d)",
                     N_loo),
  digits   = 2,
  use_gt   = TRUE
)
```

```{r fs-loo-tables-render-null}
#| eval: !expr run_single_trial
#| echo: false
# Render the LOO CV-summary table (gt).  Same auto-print pattern as
# single-trial-null-render-bootstrap-table -- the gt object is the
# last (and only) expression of the chunk, which is the only path
# that reliably triggers knit_print.gt_tbl in Quarto.
# Guarded by run_loo: when LOO was skipped, the if-block returns
# invisible(NULL) and `loo_tabs` is never referenced (short-circuit),
# so it's safe even though loo_tabs is undefined in that case.
if (run_loo) loo_tabs$combined_table
```


# Full Simulation Study {#sec-sims}

## Parameter Lists

```{r sim-params}
#| eval: !expr sim_mode != "import"
#| code-fold: true
#| code-summary: "Parallel plan setup (click to expand)"

plan(multisession, workers = n_workers)
cat("Using", n_workers, "parallel workers\n")
cat("fs_params and grf_params defined in setup chunk\n")
```

## H1 Simulations (Calibrated HTE)

```{r run-alt}
#| eval: !expr sim_mode != "import"
#| code-fold: true
#| code-summary: "H1 simulation loop (click to expand)"
#| output: false

cat("Running", nsims_alt, "simulations under H1...\n")
t0 <- proc.time()[3]

results_alt_raw <- foreach(
  sim = seq_len(nsims_alt),
  .errorhandling = "pass",
  .options.future = list(
    packages = c("forestsearch", "survival", "data.table", "future"),
    seed = TRUE
  )
) %dofuture% {
  future::plan("sequential")
  run_simulation_analysis(
    sim_id           = sim,
    dgm              = dgm_calibrated,
    n_sample         = sim_n,
    confounders_base = confounders,
    methods          = METHODS_SPEC,
    fs_params        = fs_params,
    keep             = diag_keep,
    keep_first_n     = diag_keep_first_n,
    verbose          = FALSE
  )
}

t_alt <- proc.time()[3] - t0
results_alt <- collect_results(results_alt_raw, "H1 alt",
                               keep_diagnostics = diag_keep_first_n > 0L)
n_failed_alt <- attr(results_alt, "n_failed")

cat(sprintf("Completed in %.1f min (%d rows, %d failed)\n",
    t_alt / 60, nrow(results_alt), n_failed_alt))
```

