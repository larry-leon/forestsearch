\begin{frame}{Censored Data Analysis: Estimating Survival Differences}

Transforming the observed survival times:

$$E(\varphi(Y_{i}) | L_{i}, Z_{i}) = E(T_{i} | L_{i}, Z_{i})$$

$${\varphi(Y_{i}) =  \left\{\begin{array}{ll}
\varphi_{1}(T_{i}), \quad \hbox{if uncensored,} \\
\varphi_{2}(C_{i}), \quad \hbox{if censored.}
 \end{array}
\right.}  $$

\cite{FG1994} (\cite{SDS2018} a ``DR'' version):

$$
\varphi_{1}(T_{i})  =
(1 + \theta)\int_{0}^{T_{i}}
{dt \over {\gt}}
 -{\theta}{T_{i} \over G(T_{i})} 
$$

$$
\varphi_{2}(C_{i})= (1 + \theta)\int_{0}^{C_{i}} {dt \over {\gt}}
$$

$$\theta=\min_{\left\{i: \delta_{i}=1 \right\}}
 {{\int_{0}^{Y_{i}} {dt \over {\gt}} - Y_{i}} \over
{ {Y_{i} \over G(Y_{i})} - \int_{0}^{Y_{i}} {dt \over {\gt}} }}
$$

\end{frame}






%% Adjusted KM

\begin{frame}{Standard Kaplan-Meier}

\newtheorem{chf}{Cumulative Hazard Function (CHF) Estimator} 
\newtheorem{rmkchf}{Remark}

\begin{chf}<1-> $$\hat{\Lambda}_{n}(t) =
\int_{0}^{t}{d \barN(s) \over \barY(s)} = \sum_{\tau_{i} \leq t}{d_{i} \over \barY(\tau_i)} $$
\end{chf} 

\begin{rmkchf}<1->
This is the Nelson-Aalen estimator of $\Lambda(t)$ where plugging into the relationship $S(t)=\exp(-\Lambda(t))$ yields an estimator for $S(t)$.
\end{rmkchf}

\begin{rmkchf}<2-> The Kaplan-Meier estimator is given by
$\hat{S}^{KM}(t)=\prod_{u \leq t}[1-d\hat\Lambda(u)]=\prod_{\tau_{i} \leq t}[1-d_{i}/\barY(\tau_i)].$
\end{rmkchf}

\end{frame}

\begin{frame}{Adjusted Kaplan-Meier}

\newtheorem{wchf}{Weighted CHF:} 
\newtheorem{wcounting}{Weighted Counting-Processes:}
PS weighting of the counting and at-risk processes (\cite*{CH2004}):

\begin{wchf}<1->
$$\hat\Lambda^{W}(t)=\int_{0}^{t} {d\barN^{W}(u) \over \barY^{W}(u)}$$
\end{wchf}

\begin{wcounting}<1->
$\barN^{W}(t)=\sumin W_{i}(t)N_{i}(t)$; $\barY^{W}(t)=\sumin W_{i}(t)Y_{i}(t)$
\end{wcounting}

\newtheorem{wkm}{Weighted Kaplan-Meier} 
\begin{wkm}<2-> 
$$\hat{S}^{KM}_{W}(t)=\prod_{u \leq t}[1-d\hat\Lambda^{W}(u)]$$
\end{wkm}

\end{frame}


\begin{frame}{Estimators for Censored Analysis: Estimating $\Delta=S_{1}(36)-S_{0}(36)=12.5\%$}

We consider the following analyses:

\begin{itemiz}
\item Naive denotes to the un-adjusted KM difference at 36-months;
\item KM.adj denotes the IPW adjusted KM difference at 36-months;
\item The OR, IPW, 1:1, 1:all, AIPW, BR, and TMLE all denote the 
procedures based on $Y:=I(\varphi(Y) \geq 36)$ by treating 
$\varphi(Y)$ as non-censored
\end{itemize}



\end{frame}


