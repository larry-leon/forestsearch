\begin{frame}{Non-Randomized Comparisons in Oncology}

\textbf{Project Endeavour: Phase 1b Decision Making:}
Multiple single-arm trials across hematology program (1L DLBCL, R/R DLBCL, 1L FL, and R/R FL)
\pause

\textbf{Singe-Arm vs Historical Control:}
Single-arm (SA) studies will be compared to historical-control data source: 1L DLBCL SA (n=40) vs RCHOP (GOYA trial, $n>650$)

\pause

\textbf{Atezo ``ADA'' Analysis:}
Impact of (potentially increased) immunogenicity rate for atezolizumab on survival.  Landmark analysis by 
patients' anti-drug antibodies (ADA) status measured at 4 weeks after initiation of treatment.  How to compare with chemo control arm?
FDA conducted a propensity-score matching (1:1) analysis of the OAK study and the Atezo Lung Team is considering various alternatives for this evaluation. 
\end{frame}



\begin{frame}{Project Endeavour: POLA vs RCHOP (GOYA) Baseline Characteristics}

\input{"//NAS1817CC/Causal-Inference/CrossTrialComparisons/DoubleRobustEstimation/Presentation/DRE_Intro/Pola_vs_RCHOP_bl.tex"}

\end{frame}




\begin{frame}{Potential Outcomes: Average Causal Effect (ACE)}

\textbf{Potential outcomes:} $Y_{(1)}$ and $Y_{(0)}$ denote the potential outcomes if the patient received treatment or control

\pause

\textbf{Confounder:} $L$ denote a set of confounders (baseline factors) and $Z$ denote treatment indicator 

\pause

\textbf{No unmeasured confounders assumption:} $\{Y_{(1)},Y_{(0)}\}$ are conditionally independent of $Z$ given $L$.

\pause

\textbf{ACE=$E(Y_{(1)})-E(Y_{(0)})$:}
$$ E(Y_{(a)})=E_{L}\left\{E(Y_{i} | L_{i}, Z_{i}=a)\right\}, \quad a=0,1$$ 

\end{frame}


%% OR Estimator

\begin{frame}{Regression}

\textbf{Outcome Regression (OR) Model:}
$$E[Y|Z,L]:=\mu(Z,L)=g(\alpha*Z+\beta'L)$$

\pause

\textbf{Logistic Regression Model:}
$E[Y|Z,L]=\Pr(Y=1|Z,L)=\exp(\alpha*Z+\beta'L)/(1+\exp(\alpha*Z+\beta'L))$

\pause

\textbf{Predicted $E(Y_{(1)})$:}
Patient with characteristic $L$, their potential outcome under treatment $Z=1$ is predicted as 
$$\hat\mu(Z=1,L)=g(\hat\alpha+\hat\beta'L)$$

\pause

\textbf{Predicted $E(Y_{(0)})$:} 
$$\hat\mu(Z=0,L)=g(\hat\beta'L)$$

\end{frame}



\begin{frame}{OR, IPW, and Double-Robust Estimators}

\newtheorem{orest}{OR Estimator} 

\begin{orest}<1-> $$\hat\Delta_{\hbox{OR}}=n^{-1}\sum_{i=1}^{n}\left\{\hat\mu(Z_{i}=1,L_{i})-\hat\mu(Z_{i}=0,L_{i})\right\}$$
\end{orest} 

\pause

\textbf{Propensity Score Model:}
$e(L_{i},\hat\zeta)$ is the estimated probability of receiving treatment for patient $i$ with characteristics $L_i$

\pause

\newtheorem{ipwest}{IPW Estimator} 

\begin{ipwest}<2->
$$\hat\Delta_{\hbox{ipw}}=n^{-1}\left\{\sum_{i=1}^{n}{Z_{i}Y_{i} \over e(L_{i},\hat\zeta)}
-\sum_{i=1}^{n}{(1-Z_{i})Y_{i} \over 1-e(L_{i},\hat\zeta)}\right\}$$
\end{ipwest}
\end{frame}


\begin{frame}{OR, IPW, and Double-Robust Estimators (contd)}

\textbf{OR Estimator:} 
$$\hat\Delta_{\hbox{OR}}=n^{-1}\sum_{i=1}^{n}\left\{\hat\mu(Z_{i}=1,L_{i})-\hat\mu(Z_{i}=0,L_{i})\right\}$$
\textbf{IPW Estimator:} $$\hat\Delta_{\hbox{ipw}}=n^{-1}\left\{\sum_{i=1}^{n}{Z_{i}Y_{i} \over e(L_{i},\hat\zeta)}
-\sum_{i=1}^{n}{(1-Z_{i})Y_{i} \over 1-e(L_{i},\hat\zeta)}\right\}$$
\pause
\newtheorem{drest}{DR Estimator: \cite{BR2005}} 
\begin{drest}<2-> 
$\tilde\mu_{DR}(Z=1,L)=g(\tilde\alpha+\tilde\beta'L+\tilde\eta*[1/e(L,\hat\zeta)])$; $\tilde\mu_{DR}(Z=0,L)=g(\tilde\beta'L+\tilde\eta*[1/(1-e(L,\hat\zeta))])$;  
$$\tilde\Delta_{DR}=n^{-1}\sum_{i=1}^{n}\left\{\tilde\mu_{DR}(Z_{i}=1,L_{i})-\tilde\mu_{DR}(Z_{i}=0,L_{i})\right\}$$
\end{drest} 


\end{frame}



\begin{frame}{AIPW, Matching and Targeted MLE (TMLE)}

\begin{itemize} 

\item
\cite{FD2011} develop Augmented-IPW (AIPW) double-robust estimators;
\item
For propensity score matching we apply the {\it{matching}} R package;
\item
DR estimators (TMLE) based on machine learning algorithms are described by \cite{LSRS2018}:
\item
tmle(Y, A, W, family = "binomial", Q.SL.library = SL.library, g.SL.library = SL.library);
\item
SL.library=c("SL.glm","SL.step","SL.step.interaction", "SL.glm.interaction","SL.gam", "SL.randomForest", "SL.rpart")
\end{itemize}
\end{frame}




\begin{frame}{Estimating Response Rate: Simulations Wherein $\Delta=25\%$}

\textbf{Pola vs Rchop Simulation} 
We mimic the Pola vs RCHOP characteristics in a setting where the true benefit is an increased response rate of $25\%$

\pause
\textbf{Selection to Pola (PS Model):} 
We generate treatment group (membership to the experimental) via the logistic regression model 
$$\Pr(Z=1 | X) = \hbox{expit}(X_0'\gamma)$$
\noindent $X_0$ are the true factors related to how patients are ``selected'' to the experimental arm

\pause

\textbf{Response Outcomes (OR Model):} 
$$\Pr(Y=1 | Z,V) = \hbox{expit}(\tau+\alpha*Z+V_0'\beta)$$

\noindent
$X_{0}=V_{0}=\{ipi.high,age,male,ecog.01,stage4,bulky,ldh.normal \}$; $\tau, \alpha, \beta$ such that $\Delta=E(Y_{(1)})-E(Y_{(0)})=25\%$

\paus

\textbf{Selection Bias} 
Patients are selected with bias: Experimental pts' have poorer prognostic characteristics

\end{frame}




\begin{frame}{$\Delta=25\%$: True Model where $X=V=\{ipi.high,age,male,ecog.01,stage4,bulky,ldh.normal \}$} 

\begin{figure}
\begin{center}
<<out.height="180px",out.width="180px">>=

mydir<-'//NAS1817CC/Causal-Inference/CrossTrialComparisons/DoubleRobustEstimation/Presentation/DRE_Intro'
toget<-c(paste(mydir,"/_data/DRE_Sim1_BothTrue.Rdata",sep=""))
load(toget)

out.results2<-out.results[which(out.results$estimator!="ipw"),]
out.results3<-out.results2[which(out.results2$estimator!="aipw"),]
est.order<-c("naive", "or", "1:1","1:all","br","tmle")
est<-factor(out.results3$estimator,levels=est.order)
pv<-ggplot(out.results3, aes(x=est, y=Bias))
pv2<-pv + geom_violin(aes(fill= est), draw_quantiles=c(0.25,0.5,0.75))
pv3<-pv2 + coord_flip()
pv3 + theme(legend.position="none") # Remove legend
@
\end{center}
\end{figure}

\end{frame}



