                caption="\\label{tab:findingH} Proportion (across $10,000$ simulations) any subgroup H is identified under the null and when the hazard ratio for $H$, denoted $hrH$, takes values of $1, 1.5, 2, 2.5,$ and $3.0$.
                The ideal versions of VT(24) and VT(36) are denoted by the pound symbols [Ugh, can't get pound symbol to work in latex (knitr.kable) tables... probably change notation in table output].") %>%
kable_styling("striped", full_width = F) %>%
group_rows("N=500", 1, 6) %>%
group_rows("N=700", 7, 12) %>%
group_rows("N=1000", 13, 18)
@


To quantify the classification properties we consider the following metrics.

<<echo=FALSE,message=FALSE,warning=FALSE>>=
aa<-100
bb<-400
aa1<-90
bb1<-375
@

\begin{enumerate}
\item{As a numerical example, suppose that the true $H$ consists of $100$ subjects and $H^{c}$ includes $400$ subjects (total population of 500). For a procedure that identifies $\hat{H}$ and $\hat{H}^{c}$ 
where $\hat{H}$ correctly includes $90$ of the $100$ subjects of $H$, and correctly includes $375$ of the $400$ subjects of $H^{c}$. We define the following classification metrics:}
\begin{enumerate}[{}]
\item{$$\hbox{ppH}:=\# \{i \in \hat{H} \cap H \} / \# \{i \in H \}$$}
\item{ppH represents the proportion of $H$ subjects correctly identified: $\# \{i \in H \} = \Sexpr{aa}$, $\# \{i \in \hat{H} \cap H \}=\Sexpr{aa1}$, $\hbox{ppH}=\Sexpr{aa1/aa}$}
\item{Under the null, ppH does not exist since $H=\emptyset$;}
\end{enumerate}
\begin{enumerate}[{}]
\item{$$\hbox{ppHc}:=\# \{i \in \hat{H}^{c} \cap H^{c} \} / \# \{i \in H^{c} \}$$}
\item{ppHc represents the proportion of $H^{c}$ subjects correctly identified: $\# \{i \in H^{c} \} = \Sexpr{bb}$, $\# \{i \in \hat{H}^{c} \cap H^{c} \}=\Sexpr{bb1}$, $\hbox{ppHc}=\Sexpr{bb1/bb}$;}
\end{enumerate}
\begin{enumerate}[{}]
\item{$$\hbox{sensH}:=\# \{i \in \hat{H} \cap H \} / \# \{i \in \hat{H} \}$$}
\item{sensH represents the proportion of estimated $H$ subjects, $\hat{H}$, correctly identified: $\# \{i \in \hat{H} \} = \Sexpr{aa1}$, $\# \{i \in \hat{H} \cap H \}=\Sexpr{aa1}$, $\hbox{sensH}=\Sexpr{aa1/aa1}$.  That is, in this 
scenario all identified $H$ subjects were correctly classified. In contrast, ppH shows not all $H$ subjects are identified;}
\end{enumerate}
\begin{enumerate}[{}]
\item{$$\hbox{sensHc}:=\# \{i \in \hat{H}^{c} \cap H^{c} \} / \# \{i \in \hat{H}^{c} \}$$}
\item{sensHc represents the proportion of estimated $H^{c}$ subjects, $\hat{H}^{c}$, correctly identified: $\# \{i \in \hat{H}^{c} \} = \Sexpr{bb1}$, $\# \{i \in \hat{H}^{c} \cap H^{c} \}=\Sexpr{bb1}$, $\hbox{sensHc}=\Sexpr{bb1/bb1}$.  That is, in this scenario all identified $H^{c}$ subjects were correctly classified. In contrast, ppHc shows not all $H^{c}$ subjects are identified;}
\end{enumerate}
\begin{enumerate}[{}]
\item{$$\hbox{ppHc}(\hat{H}):=\# \{i \in \hat{H}^{c} \cap H^{c}, \hat{H} \neq \emptyset \} / \# \{i \in \hat{H}^{c}, \hat{H} \neq \emptyset \}$$}
\item{$\hbox{ppHc}(\hat{H})$ represents, among $H$ subgroups identified, the proportion of estimated $H^{c}$ subjects correctly identified. In the example scenario, since $\hat{H} \neq \emptyset$, $\hbox{ppHc}(\hat{H})$ and ppHc are identical. However, under the null model, $\hbox{ppHC}(\hat{H})$ will describe the missclassification rate of $H^{c}$ subjects since when $\hat{H} \neq \emptyset$, under the null, all ($H$) identified subjects are missclassified.}
\end{enumerate}
\end{enumerate}

%\item{$\hbox{hatH_ppHc}$ represents, among $H$ subgroups identified, the proportion of estimated $H^{c}$ subjects correctly identified.}

%\item{In the example scenario, since $\hat{H} \neq \emptyset$, $\hbox{hatH_ppC}$ and ppC are identical. However, under the null model, 
%$\hbox{hatH_ppHC}$ will describe the missclassification rate of $H^{c}$ subjects since when $\hat{H} \neq \emptyset$, under the null, all ($H$) identified subjects are missclassified.}

%\item{$$\hbox{hatH_ppHc}:=\# \{i \in \hat{H}^{c} \cap H^{c}, \hat{H} \neq \emptyset \} / \# \{i \in \hat{H}^{c}, \hat{H} \neq \emptyset \}$$}


%\begin{frame}{Classification metrics: H= $\{Z_{1}=1 \}\cap \{Z_{4}=1\}$, $H^{c}$= $\{Z_{1}=0 \}\cup \{Z_{4}=0\}$}
%\begin{itemize}
%\item{Note that there always exists ${\hat H}^{c}$; $\hat H = \emptyset$ implies ${\hat H}^{c}= \Omega$}
%\item{ppH: $$\# \{i \in \hat{H} \cap H \} / \# \{i \in H \}$$}
%\item{ppHc: $$\# \{i \in \hat{H}^{c} \cap H^{c} \} / \# \{i \in H^{c} \}$$}
%\item{sensH: $$\# \{i \in \hat{H} \cap H \} / \# \{i \in \hat{H} \}$$}
%\item{sensHc: $$\# \{i \in \hat{H}^{c} \cap H^{c} \} / \# \{i \in \hat{H}^{c} \}$$}
%\item{ppHc($\hat H$): $$\# \{i \in \hat{H}^{c} \cap H^{c}, \hat{H} \neq \emptyset \} / \# \{i \in \hat{H}^{c}, \hat{H} \neq \emptyset \}$$}
%\end{itemize}
