<<echo=FALSE,message=FALSE,warning=FALSE,eval=TRUE>>=
# n=1000
load("../../simulations/m1_draft1/output/fsb_S=100_B=300_m1_N=1000_alt_ktreat=1_hrH=3.5_v1.Rdata")
res1<-res
load("../../simulations/m1_draft1/output/fsb_S=101-150_B=300_m1_N=1000_alt_ktreat=1_hrH=3.5_v1.Rdata")
res2<-res
load("../../simulations/m1_draft1/output/fsb_S=151-200_B=300_m1_N=1000_alt_ktreat=1_hrH=3.5_v1.Rdata")
res3<-res


res<-rbind(res1,res2,res3)

# H statistics
# Un-adjusted esimator
Hstats_a<-with(res,c(mean(H_obs),median(H_obs),sqrt(var(H_obs)),mean(seH_obs),min(H_obs),max(H_obs),100*c(mean(Hc0_cover1),mean(Hc0_cover2),mean(Hc0_cover3))))
Hstats_b<-with(res,c(mean(H1.bc),median(H1.bc),sqrt(var(H1.bc)),mean(seH1.bc),min(H1.bc),max(H1.bc),100*c(mean(Hc1_cover1),mean(Hc1_cover2),mean(Hc1_cover3))))
Hstats_c<-with(res,c(mean(H2.bc),median(H2.bc),sqrt(var(H2.bc)),mean(seH2.bc),min(H2.bc),max(H2.bc),100*c(mean(Hc2_cover1),mean(Hc2_cover2),mean(Hc2_cover3))))
Hstats_d<-with(res,c(mean(H_true),median(H_true),sqrt(var(H_true)),NA,min(H_true),max(H_true),NA,NA,NA))
Hstats_e<-with(res,c(mean(hatH_causal),median(hatH_causal),sqrt(var(hatH_causal)),NA,min(hatH_causal),max(hatH_causal),NA,NA,NA))
Hstats<-rbind(Hstats_d,Hstats_e,Hstats_a,Hstats_b,Hstats_c)


colnames(Hstats)<-c("Avg","median","SD","est(SD)","min","max","C(H_known)","C(H_causal)","C(H_fixed)")
rownames(Hstats)<-c("H_known","H_causal","Un-adj","BC_1","BC_2")


options(knitr.kable.NA = '.',format="latex")

tabH_est<-kable(Hstats,digits=3,format="latex",booktabs=TRUE,escape=TRUE,align="c")


df_bc<-get_df_Boxplot(res=res,dgm=dgm)

p1<-ggplot(df_bc, aes(x=target, y=bias, fill=est)) + 
  geom_boxplot(outlier.shape = NA) +
  coord_cartesian(ylim = quantile(df_bc$bias, c(0.0, 0.98),na.rm=TRUE))
@



\Sexpr{tabH_est}


\begin{figure}[h!]
\begin{center}
<<echo=FALSE,out.height="300px",out.width="400px">>=
plot(p1)
@
\end{center}
\caption{Bias of un-adjusted and bias-corrected estimators ($n=1000$)}
\label{fig:BoxPlot1000}
\end{figure}


