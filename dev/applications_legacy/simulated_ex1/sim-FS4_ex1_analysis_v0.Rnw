legend=TeX(Hl),col=c("grey","black","grey","black"),lwd=c(3,lwdHe,3,lwdHe),lty=c(1,1,2,2),bty="n",cex=legend.cex)


# Complement

# Keep same naming below (i.e., H is now H-complement)

# Treat arms for H subgroup
dfp<-subset(df,flag.harm==0)

kmH.fit<-KM.plot.2sample.weighted(Y=dfp[,c(tte.name)],E=dfp[,c(event.name)],Treat=dfp[,c(treat.name)],
risk.set=FALSE,by.risk=byrisk,tpoints.add=tpoints.add,risk.cex=risk.cex,
stop.onerror=TRUE,Xlab="Months",Ylab="Survival",details=FALSE,
show.ticks=FALSE,
col.1="grey", col.2="grey",
ltys=c(1,2),lwds=c(3,3),
plotit=TRUE,
show.Y.axis=FALSE,
show.logrank=FALSE,show.med=FALSE,show.cox=FALSE)

title(sub="(b)")

# Risk set for true H
riskH<-kmH.fit$risk.1+kmH.fit$risk.2
riskH.points<-kmH.fit$risk.points
# put on top
y.riskH<-kmH.fit$y.risk2
text(c(riskH.points),c(y.riskH),c(riskH),col="grey",cex=risk.cex)

dfp<-subset(df,treat.recommend==1)
# Do not plot (plotit=FALSE)
kmHest.fit<-KM.plot.2sample.weighted(Y=dfp[,c(tte.name)],E=dfp[,c(event.name)],Treat=dfp[,c(treat.name)],
risk.set=FALSE,by.risk=byrisk,tpoints.add=tpoints.add,risk.cex=risk.cex,
stop.onerror=TRUE,Xlab="Months",Ylab=ylab,details=FALSE,
show.ticks=FALSE,
col.1="grey", col.2="grey",
ltys=c(1,2),lwds=c(3,3),
plotit=FALSE,
show.logrank=FALSE,show.med=FALSE,show.cox=FALSE)

# Treatment arm, H estimated
lines(kmHest.fit$at.points1.plot,kmHest.fit$Y1.plot,lty=1,type="s",col="black",lwd=lwdHe)
# Control arm, H estimated
lines(kmHest.fit$at.points2.plot,kmHest.fit$Y2.plot,lty=2,type="s",col="black",lwd=lwdHe)

# Risk set for estimated H
riskHest<-kmHest.fit$risk.1+kmHest.fit$risk.2
riskHest.points<-kmHest.fit$risk.points
# put on top
y.riskHest<-kmHest.fit$y.risk1
text(c(riskHest.points),c(y.riskHest),c(riskHest),col="black",cex=risk.cex)

Hla<-sprintf(r'($H^{c}, %s$)',c("Treatment"))
Hlb<-sprintf(r'($\hat{H}^{c}, %s$)',c("Treatment"))
Hlc<-sprintf(r'($H^{c}, %s$)',c("Control"))
Hld<-sprintf(r'($\hat{H}^{c}, %s$)',c("Control"))
Hl<-c(Hla,Hlb,Hlc,Hld)

legend("top",
legend=TeX(Hl),col=c("grey","black","grey","black"),lwd=c(3,lwdHe,3,lwdHe),lty=c(1,1,2,2),bty="n",cex=legend.cex)
@
\end{center}
\caption{Simulated data example with $\approx \Sexpr{pcens}$\% censoring: (a) Kaplan-Meier (KM) curves for the true $H$ ($H$) subgroup for the treatment (solid grey) 
and control (dashed grey) arms, along with the KM curves for the estimated H ($\hat{H}$) subgroup treatment (solid black) and control (dashed black); 
(b) KM curves for the true complement $H^{c}$ ($H^{c}$) subgroup for the treatment (solid grey) 
and control (dashed grey) arms, along with the KM curves for the estimated $H^{c}$ ($\hat{H}^{c}$) subgroup treatment (solid black) and control (dashed black). The displayed risk sets 
correspond to the treatment and control arms combined for the true and estimated subgroups ($H$ and $\hat{H}$ in (a); $H^{c}$ and $\hat{H}^{c}$ in (b)).}\label{fig:simex1}
\end{figure}



Applying our novel procedure the estimated subgroup $\hat{H}$ consists of $\Sexpr{nH_est}$ subjects and thus 
$\Sexpr{nn-nH_est}$ in the estimated complement $\hat{H}^{c}$. The number of subjects in $H$ that are included in $\hat{H}$ is $\Sexpr{kH}$ (i.e., $|H \cap \hat{H}|=\Sexpr{kH}$): Of the $\Sexpr{nH_true}$ subjects in $H$, $\Sexpr{kH}/\Sexpr{nH_true}=\Sexpr{100*round(kH/nH_true,3)}\%$ are correctly classified and of the $\Sexpr{nH_est}$ subjects in $\hat{H}$, $\Sexpr{kH}/\Sexpr{nH_est}=\Sexpr{100*round(kH/nH_est,3)}\%$ are correctly classified.  For the complement, the number of subjects in $H^{c}$ that are included in $\hat{H}^{c}$ is $\Sexpr{kHc}$: Of the $\Sexpr{nHc_true}$ subjects in $H^{c}$, $\Sexpr{kHc}/\Sexpr{nHc_true}=\Sexpr{100*round(kHc/nHc_true,3)}\%$ are correctly classified and of the $\Sexpr{nHc_est}$ subjects in $\hat{H}^{c}$, $\Sexpr{kHc}/\Sexpr{nHc_est}=\Sexpr{100*round(kHc/nHc_est,3)}\%$ are correctly classified.  

In other words, $\hat{H}^{c}$ represents $\Sexpr{100*round(kHc/nHc_true,3)}\%$ of $H^{c}$, and for estimation (Cox and Kaplan-Meier)
based on $\hat{H}^{c}$: $\Sexpr{100*round(kHc/nHc_est,3)}\%$ are $H^{c}$ subjects with (marginal) hazard ratio $\hcplim=\Sexpr{round(dgm$hr.Hc.true,3)}$, and $\Sexpr{100*round(1-kHc/nHc_est,3)}\%$
are $H$ subjects with (marginal) hazard ratio $\hplim =\Sexpr{round(dgm$hr.H.true,3)}$.
%In the sequel we refer to these as specificity and sensitivity metrics for $\hat{H}$, and $\hat{H}^{c}$.

%\Sexpr{tab_ex1}


Figure \ref{fig:simex1} displays the Kaplan-Meier curves based on the true (known a-priori) subgroups and the estimated subgroups (Figures \ref{fig:simex1}(a) and \ref{fig:simex1}(b), for $H$ and $H^{c}$, respectively).  The Kaplan-Meier curves for the treatment and control arms for the actual subgroups ($H$, known a-prior) are generally well characterized by the estimated subgroups.  


Table \ref{tab:simex1} provides the Cox estimate for the overall population (ITT) as well as the estimates based on the true (known a-priori), and estimated subgroups, $\hat{H}$ and $\hat{H}^{c}$.  The ITT Cox estimate is $\Sexpr{round(as.numeric(resITT[1]),2)}$ (95\% CI=$\Sexpr{round(as.numeric(resITT[2]),2)}$, $\Sexpr{round(as.numeric(resITT[3]),2)}$), 
which is statistically insignificant and highlights the practical implications.  For characterizing $H$, recall that the underlying (marginal) hazard ratio is $\hplim =\Sexpr{round(dgm$hr.H.true,2)}$.  If the true H is known (a-priori), the Cox estimate is $\Sexpr{round(as.numeric(resH[1,1]),2)}$ (95\% CI=$\Sexpr{round(as.numeric(resH[1,2]),2)}$, $\Sexpr{round(as.numeric(resH[1,3]),2)}$), and for the estimated H, $\hat{H}$, the Cox estimate is $\Sexpr{round(as.numeric(resH[2,1]),2)}$ (95\% CI=$\Sexpr{round(as.numeric(resH[2,2]),2)}$, 
$\Sexpr{round(as.numeric(resH[2,3]),2)}$).  By the nature of the FS procedure we expect Cox model estimates based on an estimated subgroup to be upwardly biased for $H$.  We therefore describe a bootstrap bias-correction, which in this case, the bias-corrected Cox estimate denoted by $\hat{H}_{bc}$ is $\Sexpr{round(as.numeric(resH[3,1]),2)}$ (95\% CI=$\Sexpr{round(as.numeric(resH[3,2]),2)}$, $\Sexpr{round(as.numeric(resH[3,3]),2)}$) which we see provides a more ``tempered''estimate and is quite similar to the estimates based on the ideal true H in this simulated example.  
In addition, notice that the CIs for each estimate cover the underlying (marginal) respective hazard ratios 
$\hplim =\Sexpr{round(dgm$hr.H.true,2)}$ and $\hcplim =\Sexpr{round(dgm$hr.Hc.true,2)}$ for $H$ and $H^{c}$, respectively.  
The CIs for $\hat{H}$ and $\hat{H}_{bc}$ also cover the estimate based on $H$ true =  $\Sexpr{round(as.numeric(resH[1,1]),2)}$; and similarly for the complement where $H^{c}$ true =  $\Sexpr{round(as.numeric(resHc[1,1]),2)}$.  We remark that this simulated example is representative of the results observed in our simulation setting described in Section \ref{sec:sims}.




