ipak <- function(pkg){
  new.pkg <- pkg[!(pkg %in% installed.packages()[, "Package"])]
  if (length(new.pkg))
    install.packages(new.pkg, dependencies = TRUE, quietly=TRUE, verbose=FALSE)
  sapply(pkg, require, character.only = TRUE)
}
