#legend("top",
#legend=TeX(sprintf(r'($H, %s$)',c("Treatment","Treatment","Control","Control"))),
#col=c("grey","black","grey","black"),lwd=c(3,lwdHe,3,lwdHe),lty=c(1,1,2,2),bty="n",cex=legend.cex)

Hla<-sprintf(r'($H, %s$)',c("Treatment"))
Hlb<-sprintf(r'($\hat{H}, %s$)',c("Treatment"))
Hlc<-sprintf(r'($H, %s$)',c("Control"))
Hld<-sprintf(r'($\hat{H}, %s$)',c("Control"))
Hl<-c(Hla,Hlb,Hlc,Hld)

legend("top",
legend=TeX(Hl),col=c("grey","black","grey","black"),lwd=c(3,lwdHe,3,lwdHe),lty=c(1,1,2,2),bty="n",cex=legend.cex)


# Complement

# Keep same naming below (i.e., H is now H-complement)

# Treat arms for H subgroup
dfp<-subset(df,flag.harm==0)

kmH.fit<-KM.plot.2sample.weighted(Y=dfp[,c(tte.name)],E=dfp[,c(event.name)],Treat=dfp[,c(treat.name)],
risk.set=FALSE,by.risk=byrisk,tpoints.add=tpoints.add,risk.cex=risk.cex,
stop.onerror=TRUE,Xlab="Months",Ylab="Survival",details=FALSE,
show.ticks=FALSE,
col.1="grey", col.2="grey",
ltys=c(1,2),lwds=c(3,3),
plotit=TRUE,
show.Y.axis=FALSE,
show.logrank=FALSE,show.med=FALSE,show.cox=FALSE)

title(sub="(b)")

# Risk set for true H
riskH<-kmH.fit$risk.1+kmH.fit$risk.2
riskH.points<-kmH.fit$risk.points
# put on top
y.riskH<-kmH.fit$y.risk2
text(c(riskH.points),c(y.riskH),c(riskH),col="grey",cex=risk.cex)

dfp<-subset(df,treat.recommend==1)
# Do not plot (plotit=FALSE)
kmHest.fit<-KM.plot.2sample.weighted(Y=dfp[,c(tte.name)],E=dfp[,c(event.name)],Treat=dfp[,c(treat.name)],
risk.set=FALSE,by.risk=byrisk,tpoints.add=tpoints.add,risk.cex=risk.cex,
stop.onerror=TRUE,Xlab="Months",Ylab=ylab,details=FALSE,
show.ticks=FALSE,
col.1="grey", col.2="grey",
ltys=c(1,2),lwds=c(3,3),
plotit=FALSE,
show.logrank=FALSE,show.med=FALSE,show.cox=FALSE)

# Treatment arm, H estimated
lines(kmHest.fit$at.points1.plot,kmHest.fit$Y1.plot,lty=1,type="s",col="black",lwd=lwdHe)
# Control arm, H estimated
lines(kmHest.fit$at.points2.plot,kmHest.fit$Y2.plot,lty=2,type="s",col="black",lwd=lwdHe)
title(sub="(a)")
  
# Risk set for estimated H
riskHest<-kmHest.fit$risk.1+kmHest.fit$risk.2
riskHest.points<-kmHest.fit$risk.points
# put on top
y.riskHest<-kmHest.fit$y.risk1
text(c(riskHest.points),c(y.riskHest),c(riskHest),col="black",cex=risk.cex)

Hla<-sprintf(r'($H^{c}, %s$)',c("Treatment"))
Hlb<-sprintf(r'($\hat{H^{c}}, %s$)',c("Treatment"))
Hlc<-sprintf(r'($H^{c}, %s$)',c("Control"))
Hld<-sprintf(r'($\hat{H^{c}}, %s$)',c("Control"))
Hl<-c(Hla,Hlb,Hlc,Hld)

legend("top",
legend=TeX(Hl),col=c("grey","black","grey","black"),lwd=c(3,lwdHe,3,lwdHe),lty=c(1,1,2,2),bty="n",cex=legend.cex)
@
\end{center}
\caption{Simulated data example with $\approx \Sexpr{pcens}$\% censoring: (a) Kaplan-Meier (KM) curves for the true $H$ ($H$) subgroup for the treatment (solid grey) 
and control (dashed grey) arms, along with the KM curves for the estimated H ($\hat{H}$) subgroup treatment (solid black) and control (dashed black); 
(b) KM curves for the true complement $H^{c}$ ($H^{c}$) subgroup for the treatment (solid grey) 
and control (dashed grey) arms, along with the KM curves for the estimated $H^{c}$ ($\hat{H}^{c}$) subgroup treatment (solid black) and control (dashed black). The displayed risk sets 
correspond to the treatment and control arms combined for the true and estimated subgroups ($H$ and $\hat{H}$ in (a); $H^{c}$ and $\hat{H}^{c}$ in (b)).}\label{fig:simex1}
\end{figure}







