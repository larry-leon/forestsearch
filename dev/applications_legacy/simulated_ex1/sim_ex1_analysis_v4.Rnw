getci<-function(df,est,se,target,alpha=0.025){
a<-df[est]
b<-df[se]
if(!is.numeric(target)){
c<-df[target]
}
if(is.numeric(target)){
c<-target
}
log_lb<-log(a)-qnorm(0.975)*(b/a)
log_ub<-log(a)+qnorm(0.975)*(b/a)
lb<-exp(log_lb)
ub<-exp(log_ub)
cov<-ifelse(c>=lb & c<=ub,1,0)
return(list(lb=round(lb,3),ub=round(ub,3),cover=cov))
}

@






